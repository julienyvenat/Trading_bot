# Copie ce fichier en ".env" et renseigne tes clés API Alpaca (compte PAPER par défaut).
# Ne jamais commiter le fichier ".env" réel (il est ignoré par .gitignore).

# Clés API Alpaca — https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# true = compte paper trading (simulation), false = compte réel (argent réel !)
ALPACA_PAPER=true
